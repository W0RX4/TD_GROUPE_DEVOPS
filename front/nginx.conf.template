# Ce template est rendu au démarrage par l'image nginx (envsubst).
# API_UPSTREAM vaut "api:3000" par défaut : en K8s, le Service de l'API doit donc s'appeler "api".
server {
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
